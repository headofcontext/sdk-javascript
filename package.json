{
  "name": "@headofcontext/client",
  "version": "0.0.0",
  "description": "Thin TypeScript client for the HeadOfContext authorization service.",
  "keywords": [
    "authorization",
    "ai-agents",
    "headofcontext",
    "client",
    "sdk"
  ],
  "license": "Apache-2.0",
  "author": "HeadOfContext contributors",
  "homepage": "https://headofcontext.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/headofcontext/sdk-javascript.git"
  },
  "bugs": "https://github.com/headofcontext/sdk-javascript/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "contract",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.6.5",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "^22.20.2",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
